# 릴리즈 서명 설정 예시.
# 이 파일을 복사해서 android/key.properties 로 만들고 실제 값을 채우세요.
# (key.properties 는 .gitignore 로 제외됩니다 — 절대 커밋 금지)
#
#   cp android/key.properties.example android/key.properties
#
# storeFile: 릴리즈 키스토어(.jks/.keystore) 경로 (절대경로 권장, 예: D:/keys/prism-release.jks)
storeFile=D:/path/to/your-release-key.jks
storePassword=키스토어_비밀번호
keyAlias=키_별칭
keyPassword=키_비밀번호
