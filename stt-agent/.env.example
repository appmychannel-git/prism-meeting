# 이 파일을 복사해 .env 로 만들고 값을 채우세요.  cp .env.example .env
# .env 는 절대 커밋하지 마세요(키 유출). 아래는 예시일 뿐 실제 값 아님.

# LiveKit (토큰 서버가 쓰는 것과 동일한 값)
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Azure Speech (portal.azure.com → Speech service → 키/지역)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# 인식 후보 언어(쉼표, 최대 4개). 1개면 자동감지 없이 고정.
#  - 한국 테스트: ko-KR
#  - 프리덤(카자흐스탄): kk-KZ,ru-RU  (+ ko-KR,en-US 필요시)
STT_CANDIDATES=ko-KR

# 회의록에 번역문도 함께 저장할 언어(쉼표). 비우면 원문만.
#  예: TRANSCRIPT_TRANSLATE_TO=ko   (한국어 번역 함께)  /  ko,en,ru (여러 언어)
TRANSCRIPT_TRANSLATE_TO=
# 번역 API(앱과 동일한 토큰서버 /translate). 보통 그대로 두면 됨.
#TRANSLATE_URL=https://prism-token-server.onrender.com/translate

# ── 녹화(record.py, LiveKit Egress → Azure Blob) ──
# Azure Portal → 스토리지 계정 → 액세스 키에서 계정 이름/키, 컨테이너는 미리 생성.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=recordings
